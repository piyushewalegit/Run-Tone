{
  "name": "runtone",
  "displayName": "RunTone",
  "description": "Play sounds when code succeeds or fails",
  "publisher": "j0yb0y",
  "icon": "icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
  "type": "git",
  "url": "https://github.com/piyushewalegit/Run-Tone.git"
},
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
],
  "main": "./out/extension.js",
"contributes": {
  "commands": [
    {
      "command": "RunTone.chooseSuccessSound",
      "title": "RunTone: Choose Success Sound"
    },
    {
      "command": "RunTone.chooseErrorSound",
      "title": "RunTone: Choose Error Sound"
    }
  ],
  "configuration": {
    "title": "RunTone",
    "properties": {
      "RunTone.enabled": {
  "type": "boolean",
  "default": true,
  "description": "Enable or disable RunTone."
},
      "RunTone.successSound": {
        "type": "string",
        "default": "",
        "description": "Path to a custom sound file for successful code execution."
      },
      "RunTone.errorSound": {
        "type": "string",
        "default": "",
        "description": "Path to a custom sound file for failed code execution."
      }
    }
  }
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
  
}
