{
  "name": "code-sound",
  "displayName": "Code Sound",
  "description": "Play sounds when Python code succeeds or fails",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.137.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
],
  "main": "./out/extension.js",
"contributes": {
  "commands": [
    {
      "command": "code-sound.chooseSuccessSound",
      "title": "Code Sound: Choose Success Sound"
    },
    {
      "command": "code-sound.chooseErrorSound",
      "title": "Code Sound: Choose Error Sound"
    }
  ],
  "configuration": {
    "title": "Code Sound",
    "properties": {
      "codeSound.successSound": {
        "type": "string",
        "default": "",
        "description": "Path to a custom sound file for successful code execution."
      },
      "codeSound.errorSound": {
        "type": "string",
        "default": "",
        "description": "Path to a custom sound file for failed code execution."
      }
    }
  }
},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.137.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
  
}
